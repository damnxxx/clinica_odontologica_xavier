# Copie para .env local, substitua todos os valores de exemplo e nunca versione .env.
POSTGRES_DB=clinica_xavier
POSTGRES_USER=clinica_app
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinica_xavier
SPRING_DATASOURCE_USERNAME=clinica_app
SPRING_DATASOURCE_PASSWORD=change-this-postgres-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
